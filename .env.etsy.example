# Example Etsy environment variables for the uploader.
# Copy to .env (or merge into your existing .env) and fill in with your
# own credentials and IDs. DO NOT commit the real values.

ETSY_API_KEY=your_etsy_api_key
ETSY_CLIENT_SECRET=your_etsy_shared_secret
ETSY_SHOP_NAME=YourShopName

# Optional but recommended for a smoother flow
ETSY_SHOP_ID=your_numeric_shop_id
ETSY_SHIPPING_PROFILE_ID=your_shipping_profile_id
ETSY_READINESS_STATE_ID=your_readiness_state_id
ETSY_REDIRECT_URI=https://oauth.pstmn.io/v1/callback

# If you change the template listing used for copying attributes,
# update this in etsy_upload_tshirt.py or add an env var there.
# ETSY_TEMPLATE_LISTING_ID=1234567890
