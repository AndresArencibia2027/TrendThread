# Copy to .env and fill in. Do not commit .env.

# --- Etsy (primary: listing goes to your Etsy shop) ---
ETSY_API_KEY=your_keystring
ETSY_CLIENT_SECRET=your_shared_secret
ETSY_SHOP_NAME=YourShopName
# Optional: set if script can't find your shop or shipping/processing IDs
# ETSY_SHOP_ID=12345678
# ETSY_SHIPPING_PROFILE_ID=12345678
# ETSY_READINESS_STATE_ID=12345678
# ETSY_REDIRECT_URI=https://oauth.pstmn.io/v1/callback

# --- Printify (fallback; needs an "API" store in Printify) ---
PRINTIFY_API_TOKEN=your_printify_jwt_token

# Use only Printify (skip Etsy)
# USE_PRINTIFY_ONLY=0
