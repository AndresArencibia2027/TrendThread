# =============================================================================
# TrendThread environment configuration
# Copy to .env and fill in. DO NOT commit real values.
# =============================================================================

# --- Trend engine selection -------------------------------------------------
# "gemini" enables the new server-side Gemini/Vertex AI trend engine (default).
TREND_ENGINE_PROVIDER=gemini
# Keep the legacy X/GDELT/BigQuery/KnowYourMeme scraping pipeline OFF.
ENABLE_LEGACY_SCRAPING=false

# --- Google Cloud / Vertex AI (used by both trend engine + image generation) -
# Preferred new variable names:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Path to your service-account JSON key with Vertex AI access:
GOOGLE_APPLICATION_CREDENTIALS=
# Gemini model used for trend scans (default: gemini-2.0-flash):
GEMINI_TREND_MODEL=gemini-2.0-flash

# Legacy variable names are still honored as a fallback if the new ones are
# unset (so existing setups keep working):
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1

# --- Cron security ----------------------------------------------------------
# Required for POST /api/trends/daily and /api/trends/weekly.
# Send as: Authorization: Bearer <CRON_SECRET>  (or X-Cron-Secret header).
CRON_SECRET=

# --- Optional: trend database location --------------------------------------
# Defaults to ./data/trends.db
# TREND_DB_PATH=

# =============================================================================
# Legacy scraping pipeline (only needed if ENABLE_LEGACY_SCRAPING=true)
# =============================================================================
# SERPAPI_KEY=

# =============================================================================
# Printify publishing (calendar -> listing -> Printify store)
# =============================================================================
PRINTIFY_API_TOKEN=
# Optional: target a specific shop (else the first shop on the account is used)
# PRINTIFY_SHOP_ID=
# Product config. Verify these IDs against the Printify catalog API for your
# account/provider — defaults are placeholders for a basic unisex tee.
# PRINTIFY_BLUEPRINT_ID=6
# PRINTIFY_PRINT_PROVIDER_ID=1
# PRINTIFY_VARIANT_IDS=4012,4013,4014
# PRINTIFY_PRICE_CENTS=1999
# Set to true to push products live to the connected channel; default keeps drafts.
# PRINTIFY_AUTO_PUBLISH=false

# =============================================================================
# Etsy listing uploader (see LISTING_UPLOADER.md)
# =============================================================================
# ETSY_API_KEY=
# ETSY_CLIENT_SECRET=
# ETSY_SHOP_NAME=
# ETSY_SHOP_ID=
# ETSY_SHIPPING_PROFILE_ID=
# ETSY_READINESS_STATE_ID=
# ETSY_REDIRECT_URI=https://oauth.pstmn.io/v1/callback
